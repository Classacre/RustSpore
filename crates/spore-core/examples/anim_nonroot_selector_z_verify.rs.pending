//! Pending combined original-producer/all1644 selector equality gate.
use spore_core::{anim_body_capabilities,anim_nonroot_selector,anim_selector_z_bounds,native_x87};
#[path="../src/native_sse.rs"]mod native_sse;
#[path="../src/anim_nonroot_selector_z.rs"]mod selector;
use std::{error::Error,fs::{File,OpenOptions},io::{Read,Write}};
const FIELDS:[usize;39]=[0x104,0x108,0x1f8,0x1fc,0x200,0x21c,0x208,0x10c,0x110,0x114,0x118,0x11c,0x120,0x124,0x128,0x12c,0x130,0x134,0x138,0x13c,0x140,0x144,0x148,0x14c,0x344,0x348,0x34c,0x350,0x354,0x358,0x35c,0x360,0x364,0x368,0x36c,0x378,0x37c,0x204,0x20c];
fn word(b:&[u8],o:usize)->u32{u32::from_le_bytes(b[o..o+4].try_into().unwrap())}
fn field(b:&[u8],o:usize)->u32{word(b,168+FIELDS.iter().position(|x|*x==o).unwrap()*4)}
fn csr()->u32{let mut v=0;unsafe{std::arch::asm!("stmxcsr [{p}]",p=in(reg)&mut v,options(nostack,preserves_flags));}v}
fn set(v:u32){unsafe{std::arch::asm!("ldmxcsr [{p}]",p=in(reg)&v,options(nostack,preserves_flags));}}
struct Restore(u32);impl Drop for Restore{fn drop(&mut self){set(self.0)}}
fn main()->Result<(),Box<dyn Error>>{
 let a:Vec<_>=std::env::args_os().skip(1).collect();if a.len()!=4{return Err("INPUT NATIVE1040 PUBLISHER44 NEW_OUTPUT1032".into())}
 let _restore=Restore(csr());let mut inputs=File::open(&a[0])?;let mut native=File::open(&a[1])?;let mut publisher=File::open(&a[2])?;let mut output=OpenOptions::new().write(true).create_new(true).open(&a[3])?;let(mut groups,mut queries)=(0,0);
 loop{let mut h=[0;32];if inputs.read(&mut h[..1])?==0{break}inputs.read_exact(&mut h[1..])?;assert_eq!(word(&h,0),0x314c4553);let n=word(&h,4)as usize;let q=word(&h,8)as usize;assert!((1..=255).contains(&n)&&q>0&&q<=256);assert_eq!(h[20..],[0;12]);let bodyid=word(&h,16);
 let mut blocks=Vec::new();let mut boxes=Vec::new();for _ in 0..n{let mut b=[0;324];inputs.read_exact(&mut b)?;let mut caps=anim_body_capabilities::CapabilitySlots::default();for i in 0..32{caps.ids[i]=word(&b,8+i*4);caps.numbers[i]=b[136+i]}let parent=field(&b,0x1fc);blocks.push(anim_nonroot_selector::FinalizedSelectorBlock{ordinal:field(&b,0x1f8),parent:if parent==u32::MAX{None}else{Some(parent as usize)},source_palette_id:field(&b,0x21c),presence_mask:word(&b,0),nonzero_mask:word(&b,4),capabilities:caps,center:std::array::from_fn(|i|f32::from_bits(field(&b,0x10c+i*4))),half_extents:std::array::from_fn(|i|f32::from_bits(field(&b,0x138+i*4)))});boxes.push(anim_selector_z_bounds::BoundsBlock{center:std::array::from_fn(|i|field(&b,0x10c+i*4)),orientation:std::array::from_fn(|i|field(&b,0x118+i*4)),half_extents:std::array::from_fn(|i|field(&b,0x138+i*4))});}
 let mut observed_bounds=None;let mut six=None;
 for pc in[0,0x200,0x300]{for rc in[0,0x400,0x800,0xc00]{let cw=0x7f|pc|rc;let mut p=[0;44];publisher.read_exact(&mut p)?;assert_eq!(word(&p,0),bodyid);assert_eq!(word(&p,4),cw);if let Some(old)=six{assert_eq!(old,p[8..32])}six=Some(<[u8;24]>::try_from(&p[8..32])?);if cw==0x27f{observed_bounds=Some(selector::DefinitionZ::from_native_publisher_projection(&p,bodyid).map_err(|e|format!("nativebounds:{e:?}"))?)}}}
 let observed_bounds=observed_bounds.unwrap();let production=anim_selector_z_bounds::publish(&boxes,native_x87::Context::from_control_word(0x27f)?).map_err(|e|format!("publisher:{e:?}"))?;let production_bounds=selector::DefinitionZ::from_published_bounds(&production,bodyid).map_err(|e|format!("productionbounds:{e:?}"))?;
 for _ in 0..q{let mut raw=[0;32];inputs.read_exact(&mut raw)?;let mut reply=[0;1040];native.read_exact(&mut reply)?;let s=[word(&raw,0),word(&raw,4),word(&raw,8),word(&raw,12)];assert!(word(&raw,16)<=1&&word(&raw,20)<=255);assert_eq!(word(&raw,24),0);assert_eq!(u16::from_le_bytes(reply[1032..1034].try_into()?)as u32,word(&h,12));assert_eq!(u16::from_le_bytes(reply[1034..1036].try_into()?)&0x3800,0);assert_eq!(word(&reply,1036)&!0x3f,0x1f80);
 let mut expected=None;for incoming in[0x1f80,0xdf81,0xbf84]{set(incoming);let selected=selector::select(&blocks,s,word(&raw,16)!=0,word(&raw,20)as usize,observed_bounds).map_err(|e|format!("query{queries}:{e:?}"))?;assert_eq!(csr(),incoming);let production_selected=selector::select(&blocks,s,word(&raw,16)!=0,word(&raw,20)as usize,production_bounds).map_err(|e|format!("productionquery{queries}:{e:?}"))?;assert_eq!(selected,production_selected);assert_eq!(csr(),incoming);
 let mut p=[0xff;1032];p[..4].copy_from_slice(&bodyid.to_le_bytes());p[4..8].copy_from_slice(&word(&raw,28).to_le_bytes());p[8..12].copy_from_slice(&(selected.len()as u32).to_le_bytes());for(i,b)in selected.iter().enumerate(){p[12+i*4..16+i*4].copy_from_slice(&b.runtime_ordinal.to_le_bytes());assert_eq!(b.source_palette_id,blocks[b.runtime_ordinal as usize].source_palette_id)}assert_eq!(p,reply[..1032],"body{bodyid}query{queries}");if let Some(old)=expected{assert_eq!(old,p)}expected=Some(p);
 let bad=[0x80,s[1],0,0];assert!(matches!(selector::select(&blocks,bad,false,255,observed_bounds),Err(selector::Error::Selector(_))));assert_eq!(csr(),incoming);
 }output.write_all(&expected.unwrap())?;queries+=1;
 }groups+=1;
 }assert_eq!(native.read(&mut[0])?,0);assert_eq!(publisher.read(&mut[0])?,0);assert!(groups>0);output.flush()?;println!("ALL1644_SELECTOR_VERIFY bodies={groups} queries={queries} CSR_states=3 native_and_production_bounds=true actor_association=false");Ok(())
}
