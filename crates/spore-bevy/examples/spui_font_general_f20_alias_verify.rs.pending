//! Unexported all-glyph bounded coverage verifier; source provenance required.
use dbpf::native_index::NativePackageIndex;
use spore_core::spui_font_hint_program;
use spore_core::spui_font_intersection;
#[path = "../../spore-core/src/spui_font_hint_general_f20.rs"]
mod axis;
use spore_core::{
    spui_font, spui_font_hint_prep,
    spui_font_scaling::{self, DesignCoordinate},
};
use std::{
    io::{BufWriter, Write},
    path::Path,
};
fn main() -> Result<(), Box<dyn std::error::Error>> {
    let args: Vec<_> = std::env::args().skip(1).collect();
    if args.len() != 3 {
        return Err(
            "usage: verifier <Spore_Graphics.package> <owned source input TSV> <new target TSV>"
                .into(),
        );
    }
    let output = std::path::absolute(&args[2])?;
    output.strip_prefix(std::path::absolute("target")?)?;
    let package = NativePackageIndex::open(Path::new(&args[0]))?;
    let entry = package
        .entries()
        .iter()
        .find(|e| {
            e.key.type_id == spui_font::FONT_RESOURCE_TYPE
                && e.key.group_id == spui_font::FONT_NAMESPACE
                && e.key.instance_id == 0x511b49ca
        })
        .ok_or("missing font0")?;
    let data = package.read(entry)?;
    let font = spui_font::parse(&data)?;
    let metrics = font.metrics();
    let _cmap = font.cmap_format4(3, 1)?;
    let fpgm = font.table(*b"fpgm")?;
    let maxp = font.table(*b"maxp")?;
    let prep = spui_font_hint_prep::execute_font0_prep(
        fpgm,
        font.table(*b"prep")?,
        maxp,
        font.table(*b"cvt ")?,
        metrics.units_per_em,
    )
    .map_err(|e| format!("PREP: {e:?}"))?;
    let mut out = BufWriter::new(
        std::fs::OpenOptions::new()
            .create_new(true)
            .write(true)
            .open(output)?,
    );
    let design = vec![DesignCoordinate { x: 0, y: 0 }; 8];
    let ends = [3];
    for line in std::fs::read_to_string(&args[1])?.lines() {
        let values: Vec<i32> = line.split('\t').map(str::parse).collect::<Result<_, _>>()?;
        if values.len() != 22 {
            return Err("owned source input shape".into());
        }
        let scaled: Vec<_> = values[1..17]
            .chunks_exact(2)
            .map(|p| spui_font_scaling::Coordinate26Dot6 { x: p[0], y: p[1] })
            .collect();
        let mut program = vec![0xb4];
        for i in &values[17..22] {
            program.push(u8::try_from(*i)?);
        }
        program.push(0x0f);
        let r = axis::execute_simple(
            &program,
            &design,
            &scaled,
            &ends,
            &prep,
            fpgm,
            maxp,
            [65536, 65536],
        )
        .map_err(|e| format!("owned{}: {e:?}", values[0]))?;
        assert_eq!(r.cvt, prep.cvt);
        assert_eq!(r.storage, prep.storage);
        assert_eq!(r.graphics, prep.graphics);
        assert_eq!(r.reference_points, [0; 3]);
        assert_eq!(r.projection, [16384, 0]);
        assert_eq!(r.freedom, [16384, 0]);
        assert_eq!(r.dual, [16384, 0]);
        assert_eq!(r.callbacks, [0x8ab970, 0x8aba30, 0x8aba30]);
        assert_eq!(r.dot, 16384);
        assert_eq!(r.calls, 0);
        assert_eq!(r.loop_minus_one, 0);
        assert!(r.stack.is_empty());
        for (i, p) in scaled.iter().enumerate() {
            assert_eq!(r.original[i], [p.x, p.y]);
        }
        for (i, (p, touch)) in r.points.iter().zip(&r.touched).enumerate() {
            writeln!(
                out,
                "owned{}\tpoint\t{i}\t{}\t{}\t{touch}",
                values[0], p[0], p[1]
            )?;
        }
        writeln!(out, "owned{}\tfinal\t0\t0\t0\t0", values[0])?;
    }
    let ordinary = vec![spui_font_scaling::Coordinate26Dot6 { x: 0, y: 0 }; 8];
    assert!(matches!(
        axis::execute_simple(
            &[0x0f],
            &design,
            &ordinary,
            &ends,
            &prep,
            fpgm,
            maxp,
            [65536, 65536]
        ),
        Err(axis::Error::Stack)
    ));
    assert!(matches!(
        axis::execute_simple(
            &[0xb4, 4, 0, 1, 2, 255, 0x0f],
            &design,
            &ordinary,
            &ends,
            &prep,
            fpgm,
            maxp,
            [65536, 65536]
        ),
        Err(axis::Error::Index(255))
    ));
    let mut outside = ordinary.clone();
    outside[0].x = 8193;
    assert!(matches!(
        axis::execute_simple(
            &[0xb4, 4, 0, 1, 2, 3, 0x0f],
            &design,
            &outside,
            &ends,
            &prep,
            fpgm,
            maxp,
            [65536, 65536]
        ),
        Err(axis::Error::Intersection(
            spui_font_intersection::Error::Coordinates
        ))
    ));
    assert!(matches!(
        axis::execute_simple(
            &[0xb0, 10, 0x2b],
            &design,
            &ordinary,
            &ends,
            &prep,
            fpgm,
            maxp,
            [65536, 65536]
        ),
        Err(axis::Error::UnsupportedFunction(10))
    ));
    out.flush()?;
    Ok(())
}
